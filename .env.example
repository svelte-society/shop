# Storefront
STOREFRONT_ENABLED=false
CHECKOUT_ENABLED=false
MCP_ENABLED=false
SCHEDULER_ENABLED=false
STYRIA_AUTO_SUBMIT_ENABLED=false
PRODUCTION_ORIGIN=https://shop.sveltesociety.dev

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fixed EUR 10.00 gross, tax-inclusive, using Stripe's Shipping tax code (customer pays €10.00 in every destination).
STRIPE_PAID_SHIPPING_RATE_ID=
# Fixed EUR 0.00, tax-exclusive, using Stripe's Shipping tax code.
STRIPE_FREE_SHIPPING_RATE_ID=

# SQLite one-time bootstrap switch
DATABASE_BOOTSTRAP=false

# Withdrawal payload encryption (32 random bytes, canonical base64; runtime secret)
# Generate with: node --input-type=module --eval "import { randomBytes } from 'node:crypto'; process.stdout.write(randomBytes(32).toString('base64') + '\\n')"
WITHDRAWAL_DATA_KEY=

# MCP
MCP_BEARER_TOKEN=

# Styria
# Keep automatic submission false until the account has no usable credits (or automatic credit
# consumption is disabled). Vendor payment remains a manual Styria Dashboard action.
STYRIA_APP_ID=
STYRIA_SECRET_KEY=

# Resend
RESEND_API_KEY=

# S3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY_BASE64=

# Umami
UMAMI_SCRIPT_URL=
UMAMI_CONNECT_ORIGIN=
UMAMI_WEBSITE_ID=
